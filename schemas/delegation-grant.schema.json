{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentiam.dev/schemas/delegation-grant.schema.json",
  "title": "AgentIAM Hierarchical Delegation Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["delegation_id", "delegator_id", "delegate_id", "purpose", "resources", "actions", "issued_at", "expires_at", "max_child_depth", "required_approvals", "revoked"],
  "properties": {
    "delegation_id": {"type": "string", "minLength": 3},
    "delegator_id": {"type": "string", "minLength": 3},
    "delegate_id": {"type": "string", "minLength": 3},
    "purpose": {"type": "string", "minLength": 1},
    "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "parent_id": {"type": ["string", "null"]},
    "max_child_depth": {"type": "integer", "minimum": 0},
    "remaining_budget": {"type": ["number", "null"], "minimum": 0},
    "geographic_boundary": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "data_classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_approvals": {"type": "integer", "minimum": 0},
    "revoked": {"type": "boolean"}
  }
}
